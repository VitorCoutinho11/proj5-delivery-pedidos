// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  output        = "./generated/client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model pedido {
  pedido_id              Int           @id @default(autoincrement()) 
  usuario_id             Int
  restaurante_id         Int
  pedido_status          Int
  pedido_valor_total     Float
  pedido_criacao_pedido  DateTime

  itens item_pedido[]

  @@map("pedido")
}

model item_pedido {
  item_pedido_id         Int           @id @default(autoincrement()) 
  item_pedido_quantidade Int
  item_pedido_preco      Float
  pedido_id              Int
  prato_id               Int

  pedido pedido @relation(fields: [pedido_id], references: [pedido_id])

  @@map("item_pedido")
}
